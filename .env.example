# ── Persistent Storage (Railway Volume Compatible) ─
# Defaults to 'data' in the project root for local development.
# On Railway, set to '/data' and attach a persistent Volume mounted to /data.
DATA_DIR=data

# ── AI ──────────────────────────────────────────────
GEMINI_API_KEY=

# ── Gmail OAuth 2.0 ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ── Security ────────────────────────────────────────
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
ADMIN_RECOVERY_KEY=

# ── Application ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
USER_TIMEZONE=Asia/Kolkata

# ── Sending Schedule ────────────────────────────────
MAX_DAILY_EMAILS=30
SEND_INTERVAL_MINUTES=3
SEND_START_HOUR=10
SEND_START_MINUTE=0
